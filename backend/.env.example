APP_NAME=CDSS Backend
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cdss_db

JWT_SECRET_KEY=change_this_to_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

YOLO_MODEL_PATH=models/weights/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cpu

UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE=10485760